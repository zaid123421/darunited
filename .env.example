# ── Backend API origin only (`/api` is prefixed in code) ──
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_DIRECT_BACKEND_API=true

# Temporary: Skip OTP and enter dashboard without backend. Keep false for real auth.
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# OTP debug codes — NEVER enable on a public deploy.
EXPOSE_OTP_DEBUG=true
NEXT_PUBLIC_EXPOSE_OTP_DEBUG=true

# Cloudflare Turnstile — local test keys (always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_TEST_TOKEN=1x0000000000000000000000000000000AA

# Firebase Cloud Messaging (fill when project is created)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Backend API (set when DARUNITED API is ready) ──
BACKEND_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_USE_DIRECT_BACKEND_API=true

# Temporary: Send Verification logs you in as super_admin (no OTP / no backend).
# Works in production too until the API is ready — then set both to false/remove.
DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# OTP debug codes — NEVER enable on a public deploy.
EXPOSE_OTP_DEBUG=true
NEXT_PUBLIC_EXPOSE_OTP_DEBUG=true

# Firebase Cloud Messaging (fill when project is created)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
